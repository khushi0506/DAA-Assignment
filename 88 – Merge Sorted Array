class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int[] res = new int[m+n];
        int i =0;
        int j = 0;
        for(int k = 0;k<res.length;k++){
            if( i<m && j<n && nums1[i] < nums2[j]){
                res[k] = nums1[i];
                i++;
            }else if( j<n && i<m && nums1[i] > nums2[j] ){
                res[k] = nums2[j];
                j++;
            }else if(i < m){
                res[k] = nums1[i];
                i++;
            }else if(j < n){
                res[k] = nums2[j];
                j++;
            }
        }
        int a = 0;
        for(int l: res){
            nums1[a] = l;
            a++;
        }
    }
}
