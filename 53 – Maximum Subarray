class Solution {
    public static int max(int a, int b){
        if( a > b){
            return a;
        }
        return b;
    }
    public int maxSubArray(int[] nums) {
        int total = 0;
        int res = Integer.MIN_VALUE;
        for(int i : nums){
            if(total < 0){
                total = 0;
            }
            total += i;
            res = max(res,total);
        }
        return res;
    }
}
