class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int m = nums1.length;
        int b = nums2.length;
        int[] res = new int[m+b];
        int i=0;
        int j=0;
        int k=0;
        while(i<m && j<b){
            if(nums1[i] <= nums2[j]){
                res[k++]=nums1[i++];
            }else{
                res[k++]=nums2[j++];
            }
        }
        while(i<m){
            res[k++]=nums1[i++];
        }
        while(j<b){
            res[k++] = nums2[j++];
        }
        k= m+b;
        double r = 0;
        if(k%2!= 0){
            r = res[k/2]; 
        }else{
            r = (res[k/2]+res[(k/2)-1])/2.0;
        }
        return r;
    }
}
