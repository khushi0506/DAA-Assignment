class Solution {
    public int search(int[] nums, int target) {
        int res = -1;
        int l = 0;
        int r = nums.length-1;
        while(l <= r){
        int mid = (r+l)/2;
            if(nums[mid] == target){
                res = mid;
                break;
            }else if(nums[mid] > target){
                r = mid -1;
            }else{
                l = mid+1;
            }
        }
        return res;
    }
}
